# 只放變數名稱，真正的值請設在 Vercel / 本機環境變數，不要提交
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 白名單：允許使用的 LINE userId，逗號分隔（v1 只有冠璋）
ALLOWED_LINE_USER_IDS=
# 設為 true 時，任何人傳訊息都會回覆自己的 userId，用來取得 ID；取得後務必關掉
BOOTSTRAP_MODE=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
# 預設 claude-sonnet-5-5，可用環境變數覆寫
ANTHROPIC_MODEL=
# 請假表同步（服務帳戶唯讀）
GOOGLE_SERVICE_ACCOUNT_JSON=
LEAVE_SHEET_ID=
CRON_SECRET=
# 語音轉文字（OpenAI）
OPENAI_API_KEY=
# 預設 gpt-4o-transcribe，可用環境變數覆寫（例如 whisper-1）
OPENAI_TRANSCRIBE_MODEL=
# LIFF 看板
LIFF_ID=
# LINE Login channel 的 Channel ID（用來向 LINE 驗證網頁登入的 ID token，不是機密）
LINE_LOGIN_CHANNEL_ID=
