{
  "functions": {
    "api/line/webhook.ts": {
      "maxDuration": 60
    },
    "api/cron/sync-leaves.ts": {
      "maxDuration": 60
    },
    "api/liff.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-leaves",
      "schedule": "0 22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/liff/:route",
      "destination": "/api/liff?route=:route"
    },
    {
      "source": "/liff",
      "destination": "/liff/index.html"
    },
    {
      "source": "/liff/:page",
      "destination": "/liff/:page.html"
    }
  ]
}
